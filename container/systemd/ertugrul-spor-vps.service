[Unit]
Description=Ertugrul YZ 7/24 VPS Spor ve Iddaa Ogrenme Robotu
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ertugrul-spor-vps
ExecStart=/usr/bin/python3 core/vps_spor_daemon.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Istanbul

[Install]
WantedBy=multi-user.target
